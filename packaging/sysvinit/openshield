#!/bin/sh
### BEGIN INIT INFO
# Provides:          openshield
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Should-Start:
# Should-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: OpenShield application-aware firewall
### END INIT INFO

set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

daemon=/usr/bin/openshield-daemon
runtime_directory=/run/openshield
state_directory=/var/lib/openshield
pidfile=$runtime_directory/daemon.pid

prepare_runtime_directory() {
    install -d -o root -g root -m 0755 "$runtime_directory"
}

prepare_state_directory() {
    install -d -o root -g root -m 0700 "$state_directory"
}

read_pid() {
    [ -f "$pidfile" ] || return 1
    IFS= read -r service_pid < "$pidfile" || return 1
    case "$service_pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$service_pid" -gt 1 ] || return 1
}

daemon_is_running() {
    read_pid || return 1
    kill -0 "$service_pid" 2>/dev/null || return 1
    # Do not trust a stale PID that has been reused by an unrelated process.
    start-stop-daemon --stop --test --quiet \
        --pidfile "$pidfile" --exec "$daemon" >/dev/null 2>&1
}

case "${1:-}" in
    start)
        prepare_runtime_directory
        if daemon_is_running; then
            printf '%s\n' 'openshield is already running'
            exit 0
        fi
        rm -f "$pidfile"
        # Do this before group/NSS setup so every later failure remains
        # fail-closed.  It is deliberately after the already-running check:
        # the singleton daemon lock rejects a second policy transaction.
        "$daemon" --install-fail-closed
        prepare_state_directory
        /usr/libexec/openshield/ensure-group
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$pidfile" --exec "$daemon" --startas "$daemon"
        ;;
    stop)
        if read_pid; then
            start-stop-daemon --stop --quiet --retry TERM/10/KILL/5 \
                --pidfile "$pidfile" --exec "$daemon" || true
        fi
        rm -f "$pidfile"
        "$daemon" --install-fail-closed
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        if daemon_is_running; then
            printf 'openshield is running as pid %s\n' "$service_pid"
            exit 0
        fi
        printf '%s\n' 'openshield is not running'
        exit 3
        ;;
    *)
        printf 'usage: %s {start|stop|restart|force-reload|status}\n' "$0" >&2
        exit 2
        ;;
esac
